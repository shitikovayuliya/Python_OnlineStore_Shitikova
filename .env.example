# =============================================================================
# Переменные окружения для интернет-магазина
# =============================================================================
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
# =============================================================================

# Секретный ключ Django (сгенерируйте новый!)
# Для генерации: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Режим отладки: True для разработки, False для продакшена
DEBUG=False

# Хосты, разрешённые для подключения (через запятую, без пробелов)
ALLOWED_HOSTS=localhost,127.0.0.1

# Настройки базы данных PostgreSQL
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=mypassword
DB_HOST=db          # В Docker — имя сервиса; локально — localhost
DB_PORT=5432
